# Copy this file to .env and fill in the values.
# docker compose reads .env automatically; for local runs, call `assay` from the
# directory that contains .env (load_dotenv loads it at startup).
#
# Process environment variables already set always take precedence over .env.
# Do not commit your .env file — it contains real credentials.

# ---------------------------------------------------------------------------
# Agent (Claude Agent SDK)
# ---------------------------------------------------------------------------

# Required: Anthropic API key for the Claude Code CLI.
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional model and reasoning effort overrides (defaults shown).
# ASSAY_MODEL=claude-sonnet-5
# ASSAY_EFFORT=high

# ---------------------------------------------------------------------------
# Third-party gateway (optional — leave unset to use Anthropic directly)
# ---------------------------------------------------------------------------
# Point the SDK at any Anthropic-compatible endpoint (e.g. OpenRouter).
# When ANTHROPIC_BASE_URL is set, ANTHROPIC_API_KEY is ignored and
# ANTHROPIC_AUTH_TOKEN is used instead.
# ANTHROPIC_BASE_URL=https://openrouter.ai/api
# ANTHROPIC_AUTH_TOKEN=your-gateway-auth-token-here
# ASSAY_MODEL=anthropic/claude-sonnet-4.5

# ---------------------------------------------------------------------------
# Application under test (required for `assay check`)
# ---------------------------------------------------------------------------

# URL of the running application to test (http or https).
ASSAY_BASE_URL=http://localhost:3000

# Optional login URL. Defaults to ASSAY_BASE_URL when credentials are supplied.
# ASSAY_LOGIN_URL=http://localhost:3000/login

# ---------------------------------------------------------------------------
# Test credentials (optional — supply both or neither)
# ---------------------------------------------------------------------------

# ASSAY_TEST_USERNAME=testuser@example.com
# ASSAY_TEST_PASSWORD=your-test-password-here

# ---------------------------------------------------------------------------
# Auth state and context files (optional)
# ---------------------------------------------------------------------------

# Path to a Playwright storage-state file. When present, the browser loads
# cookies and localStorage from this file, bypassing the login flow.
# (The file is created automatically on the first successful login run.)
# ASSAY_AUTH_STATE=./auth-state.json

# Local Markdown file describing login steps and authenticated-state checks.
# ASSAY_AUTH_NOTES_FILE=./auth-notes.md

# Local synthetic fixture data or instructions for the agent.
# ASSAY_TEST_DATA_FILE=./test-data.md

# ---------------------------------------------------------------------------
# Scope and budget
# ---------------------------------------------------------------------------

# Comma-separated browser origins the agent is allowed to navigate to.
# Defaults to the ASSAY_BASE_URL origin when not set.
# ASSAY_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Whether the agent may create, edit, or delete records during testing.
# false (default) = read-only; true = mutations allowed.
# ASSAY_ALLOW_MUTATIONS=false

# Test depth: low | medium | high (default: medium).
# Controls max scenarios, actions, and run time — see docs for presets.
# ASSAY_DEPTH=medium

# Optional per-run budget overrides (positive integers/numbers).
# ASSAY_MAX_SECONDS=600
# ASSAY_MAX_ACTIONS=100
# ASSAY_MAX_COST_USD=1.00

# ---------------------------------------------------------------------------
# Infrastructure
# ---------------------------------------------------------------------------

# Directory where run reports are written (default: ./results).
# ASSAY_RESULTS_DIR=./results

# Browser display options.
# ASSAY_HEADLESS=true
# ASSAY_SLOWMO_MS=0
# ASSAY_NAV_TIMEOUT_MS=30000
# ASSAY_ACTION_TIMEOUT_MS=10000
# ASSAY_SHOW_EVIDENCE=true

# Save a browser recording per check scenario (<output>/<scenario-id>/video.webm).
# Recordings may capture sensitive on-screen data.
# ASSAY_RECORD_VIDEO=false
